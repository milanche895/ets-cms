generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

/// Улоге CMS-а. Панел користе ADMIN и UNION.
enum Role {
  ADMIN
  EDITOR
  AUTHOR
  STUDENT
  UNION
  PARLIAMENT
  AKTIV
}

/// Обавештење или активност синдикалне организације.
enum UnionPostKind {
  ANNOUNCEMENT
  ACTIVITY
}

/// DRAFT = нацрт, PUBLISHED = видљиво, HIDDEN = сакривено.
enum ContentStatus {
  DRAFT
  PUBLISHED
  HIDDEN
}

model User {
  id           String    @id @default(cuid()) @map("_id")
  name         String
  email        String    @unique
  passwordHash String
  role         Role      @default(AUTHOR)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  pages        Page[]
  articles     Article[]
  media        Media[]
  unionPosts   UnionPost[]
  groupPosts   SchoolGroupPost[]

  @@map("users")
}

model Page {
  id             String        @id @default(cuid()) @map("_id")
  title          String
  slug           String        @unique
  content        String
  featuredImage  String?
  status         ContentStatus @default(DRAFT)
  seoTitle       String?
  seoDescription String?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  createdById    String
  createdBy      User          @relation(fields: [createdById], references: [id])

  @@map("pages")
}

model Category {
  id          String    @id @default(cuid()) @map("_id")
  name        String
  slug        String    @unique
  description String    @default("")
  articles    Article[]

  @@map("categories")
}

model Article {
  id             String        @id @default(cuid()) @map("_id")
  title          String
  slug           String        @unique
  excerpt        String
  content        String
  featuredImage  String?
  categoryId     String?
  category       Category?     @relation(fields: [categoryId], references: [id])
  status         ContentStatus @default(DRAFT)
  publishedAt    DateTime?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  authorId       String
  author         User          @relation(fields: [authorId], references: [id])
  seoTitle       String?
  seoDescription String?

  @@index([status, publishedAt])
  @@map("articles")
}

model Media {
  id           String   @id @default(cuid()) @map("_id")
  filename     String
  url          String
  publicId     String?
  alt          String   @default("")
  mimeType     String
  size         Int
  createdAt    DateTime @default(now())
  uploadedById String
  uploadedBy   User     @relation(fields: [uploadedById], references: [id])

  @@map("media")
}

model Menu {
  id    String     @id @default(cuid()) @map("_id")
  name  String
  slug  String     @unique
  items MenuItem[]

  @@map("menus")
}

model MenuItem {
  id        String     @id @default(cuid()) @map("_id")
  label     String
  href      String
  sortOrder Int
  enabled   Boolean    @default(true)
  menuId    String
  menu      Menu       @relation(fields: [menuId], references: [id], onDelete: Cascade)
  parentId  String?
  parent    MenuItem?  @relation("MenuChildren", fields: [parentId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  children  MenuItem[] @relation("MenuChildren")

  @@index([menuId, sortOrder])
  @@map("menu_items")
}

model SiteSettings {
  id             String @id @default("default") @map("_id")
  schoolName     String
  shortName      String
  nameLine1      String
  nameLine2      String
  location       String
  tagline        String
  aboutTeaser    String
  aboutFacts     Json
  address        String
  city           String
  postalCode     String
  phone          String
  phoneAlt       String?
  email          String
  facebookUrl    String?
  instagramUrl   String?
  youtubeUrl     String?
  seoTitle       String
  seoDescription String

  @@map("site_settings")
}

/// Један запис: подаци о синдикалној организацији школе.
model UnionProfile {
  id             String  @id @default("default") @map("_id")
  name           String
  logo           String?
  summary        String
  about          String
  presidentName  String
  email          String
  phone          String
  office         String
  officeHours    String
  membership     String
  benefits       String
  affiliation    String
  facebookUrl    String?
  seoTitle       String
  seoDescription String

  @@map("union_profile")
}

model UnionPost {
  id             String         @id @default(cuid()) @map("_id")
  kind           UnionPostKind
  title          String
  slug           String         @unique
  excerpt        String
  content        String
  featuredImage  String?
  location       String?
  startsAt       DateTime?
  status         ContentStatus  @default(DRAFT)
  publishedAt    DateTime?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  authorId       String
  author         User           @relation(fields: [authorId], references: [id])
  seoTitle       String?
  seoDescription String?

  @@index([status, kind, publishedAt])
  @@map("union_posts")
}

enum SchoolGroupKey {
  PARLIAMENT
  AKTIV
}

/// Један запис за ђачки парламент или за активе.
model SchoolGroup {
  key            SchoolGroupKey @id @map("_id")
  name           String
  logo           String?
  summary        String
  about          String
  presidentName  String
  email          String
  phone          String
  office         String
  officeHours    String
  membership     String
  benefits       String
  affiliation    String
  facebookUrl    String?
  seoTitle       String
  seoDescription String
  posts          SchoolGroupPost[]

  @@map("school_groups")
}

model SchoolGroupPost {
  id             String         @id @default(cuid()) @map("_id")
  groupKey       SchoolGroupKey
  group          SchoolGroup    @relation(fields: [groupKey], references: [key])
  kind           UnionPostKind
  title          String
  slug           String
  excerpt        String
  content        String
  featuredImage  String?
  location       String?
  startsAt       DateTime?
  status         ContentStatus  @default(DRAFT)
  publishedAt    DateTime?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  authorId       String
  author         User           @relation(fields: [authorId], references: [id])
  seoTitle       String?
  seoDescription String?

  @@unique([groupKey, slug])
  @@index([groupKey, status, kind, publishedAt])
  @@map("school_group_posts")
}
