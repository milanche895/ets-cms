# Адреса MongoDB базе. Упишите свој корисник, лозинку и назив базе. Не шаљите овај фајл са правом лозинком.
DATABASE_URL="mongodb+srv://KORISNIK:LOZINKA@cluster.mongodb.net/ets-cms?retryWrites=true&w=majority"

# Тајна за пријаву. Направите дугачак насумичан текст, најмање 32 знака.
AUTH_SECRET="zamenite-ovaj-tekst-nasumicnim-nizom-od-32-znaka"

# Први администратор. Лозинка се не пише у код сајта.
ADMIN_NAME="Администратор"
ADMIN_EMAIL="admin@ets.edu.rs"
ADMIN_PASSWORD="promenite-ovu-lozinku"

# Адреса сајта, за SEO.
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
